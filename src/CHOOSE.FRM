Option Explicit
Dim m001A As Long
Const mc0020 = 11 ' &HB%
Const mc0056 = 1 ' &H1%

Sub b_Image_Click (Index%)
' Const mc0020 = 11 ' &HB%
    MousePointer = mc0020
    Call sub314A(Index)
End Sub

Sub sub314A (p0028 As Integer)
Static m002A As Long
' Const mc0056 = 1 ' &H1%
            frm_ChooseShip.BackColor = m002A
            frm_ChooseShip.VSElastic1.Visible = False
            Load frm_Box1Rect
            frm_Box1Rect.b_Yes.Visible = True
            frm_Box1Rect.b_No.Visible = True
            frm_Box1Rect.b_OK.Visible = False
            frm_Box1Rect.b_Container.BackColor = &H400000&
            frm_Box1Rect.Image1.Picture = LoadPicture(Trim$(gv09F0.M4BF5) + "ship" + Trim$(Str$(p0028)) + ".bmp")
            frm_ChooseShip.b_Sound.Command = "Close"
            If  gv0060.M4C47 = True Then
                frm_Box1Rect.b_Sound.Command = "Close"
                If  p0028 <= 6 Then
                    frm_Box1Rect.b_Sound.FileName = Trim$(gv09F0.M4C15) + "ship" + Trim$(Str$(p0028)) + ".wav"
                Else
                    frm_Box1Rect.b_Sound.FileName = Trim$(gv09F0.M4C15) + "ship" + Trim$(Str$(p0028 - 6)) + ".wav"
                End If
                frm_Box1Rect.b_Sound.Command = "Open"
                frm_Box1Rect.b_Sound.Command = "Play"
            End If
            Select Case p0028
                Case 1
                    frm_Box1Rect.b_ImageLable = "Stinger XII"
                    frm_Box1Rect.b_Message = "The Stinger XII costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a speed demon. It comes with a high-powered 7 kuarp engine, requires 4 crew members to operate, and can carry up to 100 tons of cargo and 8 passengers. The one disadvantage is that the fuel tank is only 20 tons." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 2
                    frm_Box1Rect.b_ImageLable = "The Fly Catcher"
                    frm_Box1Rect.b_Message = "The Fly Catcher costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is designed especially for hauling cargo. It can carry up to 120 tons of cargo and comes with a 40-ton fuel tank, a 5 kuarp engine and room for 8 passengers. The one disadvantage is that it requires 5 crew members to operate." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 3
                    frm_Box1Rect.b_ImageLable = "Le Rock"
                    frm_Box1Rect.b_Message = "Le Rock costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is sure to please even the most frugal merchants. It requires only 3 crew members and has a 65-ton fuel tank, a 5 kuarp engine and room for 8 passengers. The one disadvantage is that it can hold only 80 tons of cargo." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 4
                    frm_Box1Rect.b_ImageLable = "Whaler 2000"
                    frm_Box1Rect.b_Message = "Whaler 2000 is a monster of a ship. It costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and can carry up to 130 tons of cargo, 50 tons of fuel and 11 passengers. The disadvantages are that it only has a 2 kuarp engine and requires 6 crew members to operate." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 5
                    frm_Box1Rect.b_ImageLable = "Retina"
                    frm_Box1Rect.b_Message = "Retina costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a sleek, slim ship. It requires only 3 crew members to operate and comes with a 5 kuarp engine, 40-ton fuel tank and 100-ton cargo capacity. The one disadvantage is that it only has room for 6 passengers." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 6
                    frm_Box1Rect.b_ImageLable = "Cerebralis"
                    frm_Box1Rect.b_Message = "Cerebralis costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is the industry standard. It comes equipped with 100 tons of cargo capacity, a 5 kuarp engine, a 40-ton fuel tank, 4 crew members and room for 8 passengers." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 7
                    frm_Box1Rect.b_ImageLable = "The Globulizer"
                    frm_Box1Rect.b_Message = "The Globulizer costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is incredibly light weight and quick. It has a turbocharged 7 kuarp engine, requires 4 crew members to operate, and comes with a 30-ton fuel tank and seating for 7 passengers. The disadvantage is that it has only an 80-ton cargo bay." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 8
                    frm_Box1Rect.b_ImageLable = "Locomotis"
                    frm_Box1Rect.b_Message = "Locomotis costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a sturdy workhorse. It requires 4 crew members to operate and comes with a 110-ton cargo bay, a powerful 6 kuarp engine, a 40-ton fuel tank, and room for 5 passengers." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 9
                    frm_Box1Rect.b_ImageLable = "Mantagon"
                    frm_Box1Rect.b_Message = "Mantagon costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a highly efficient and well-designed merchant ship. It can carry up to 10 passengers, has a 4 kuarp engine, a 40-ton fuel tank, and a 90-ton cargo bay. The nice thing is that it only requires 3 crew members to operate." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 10
                    frm_Box1Rect.b_ImageLable = "Kegger"
                    frm_Box1Rect.b_Message = "Kegger costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a massive transport vessel. It can carry up to 150 tons of cargo and 35 tons of fuel, but it only has room for 1 passenger. It requires 2 crew members to operate and comes with a 3 kuarp engine." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 11
                    frm_Box1Rect.b_ImageLable = "Worm Shuttle"
                    frm_Box1Rect.b_Message = "Worm Shuttle costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a deluxe passenger liner. It can accomodate up to 16 passengers and comes with a speedy 6 kuarp engine and 30-ton fuel tank. The drawbacks are that it requires 12 crew members to operate and has a small 75-ton cargo bay." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
                Case 12
                    frm_Box1Rect.b_ImageLable = "Squidocity"
                    frm_Box1Rect.b_Message = "Squidocity costs " + Format$(gv0BF2.M4FBD, "#,#0") + " kubars and is a smartly designed freighter. It can carry up to 110 tons of cargo and comes with a 40-ton fuel tank, room for 8 passengers, and a fast 6 kuarp engine. The one disadvantage is that it requires 6 crew members to operate." + Chr$(10) + Chr$(10) + "Do you wish to purchase this ship?"
            End Select
            frm_Box1Rect.Show 1
    If  frm_Box1Rect.Tag = "YES" Then
        Unload frm_Box1Rect
        frm_ChooseShip2.b_Yes.Visible = False
        frm_ChooseShip2.b_No.Visible = False
        frm_ChooseShip2.b_OK.Visible = True
