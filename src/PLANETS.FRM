' PLANETS.FRM
Option Explicit
Const mc001A = 11 ' &HB%
Dim m004A As Long
Const mc0072 = 1 ' &H1%

Sub b_Continue_Click ()
    MousePointer = mc001A
    If  gv11CE.M53EF <> 1 Then
        frm_NameCompany.Tag = "Next Player"
    End If
    FillElastic.Visible = False
    frm_NameCompany.Show
    Unload frm_Planets
End Sub

Sub b_Continue_MouseDown (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Continue.BackColor = &H404040&
End Sub

Sub b_Continue_MouseUp (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Continue.BackColor = m004A
End Sub

Sub b_Planet_Click (Index%)
    MousePointer = mc001A
    If  gv0060.M4C47 = True Then
        b_Sound.Command = "Close"
        b_Sound.FileName = Trim$(gv09F0.M4C15) + "ping2.wav"
        b_Sound.Command = "Open"
        b_Sound.Command = "Play"
    End If
    frm_Planets.Tag = Str$(Index)
    frm_Planets2.Show 1
End Sub

Sub b_Randomize_Click ()
Dim l0062
Dim l0064
Dim l0066
Dim l0068 As String
' Const mc0072 = 1 ' &H1%
MousePointer = mc001A
For l0066 = 1 To 6
    For l0062 = 0 To 6
        Select Case fn01AE(0, 13)
            Case 0
                l0068 = "Vexx"
            Case 1
                l0068 = "Pyke"
            Case 2
                l0068 = "Mira"
            Case 3
                l0068 = "Stye"
            Case 4
                l0068 = "Loro"
            Case 5
                l0068 = "Zile"
            Case 6
                l0068 = "Frac"
            Case 7
                l0068 = "Tilo"
            Case 8
                l0068 = "Queg"
            Case 9
                l0068 = "Xeen"
            Case 10
                l0068 = "Ooom"
            Case 11
                l0068 = "Hork"
            Case 12
                l0068 = "Bass"
            Case 13
                l0068 = "Nosh"
        End Select
        For l0064 = 0 To 6
            If  l0068 = gv11CE.M53C1(l0064) Then l0068 = "do not replace"
        Next
        If  l0068 = "do not replace" Then
        Else
            gv11CE.M53C1(l0062) = l0068
        End If
    Next
Next
For l0062 = 0 To 6
    b_Planet(l0062).Picture = LoadPicture(Trim$(gv09F0.M4BF5) + gv11CE.M53C1(l0062) + "1.bmp")
    b_Planet(l0062) = gv11CE.M53C1(l0062)
Next
If  gv0060.M4C47 = True Then
    b_Sound.Command = "Close"
    b_Sound.FileName = Trim$(gv09F0.M4C15) + "ping1.wav"
    b_Sound.Command = "Open"
    b_Sound.Command = "Play"
End If
MousePointer = mc0072
End Sub

Sub b_Randomize_MouseDown (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Randomize.BackColor = &H404040&
End Sub

Sub b_Randomize_MouseUp (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Randomize.BackColor = m004A
End Sub

Sub Form_Activate ()
Dim l008A
    For l008A = 0 To 6
        b_Planet(l008A).Picture = LoadPicture(Trim$(gv09F0.M4BF5) + gv11CE.M53C1(l008A) + "1.bmp")
        b_Planet(l008A) = gv11CE.M53C1(l008A)
    Next
    If  gv0060.M4C47 = True Then
        b_Sound.Command = "Close"
        b_Sound.FileName = Trim$(gv09F0.M4C15) + "ping1.wav"
        b_Sound.Command = "Open"
        b_Sound.Command = "Play"
    End If
    MousePointer = mc0072
End Sub

Sub Form_KeyPress (KeyAscii As Integer)
    Select Case KeyAscii
        Case 13, 27, 32
            Call b_Continue_Click
    End Select
End Sub

Sub Form_Load ()
    MousePointer = mc001A
    FillElastic.Picture = LoadPicture(Trim$(gv09F0.M4BF5) + "STARS2.BMP")
End Sub

Sub Label1_Click ()
    Label1 = "This is the galaxy of Hannah Anna."
End Sub

Sub Label2_Click ()
    Label2 = "This region of Kukubia is known for its lush, black scenery and open space."
End Sub
