Sub b_Exit_Click ()
    MousePointer = mc0032
    FillElastic.Visible = False
    frm_File.Show
    Unload frm_SaveGame
End Sub

Sub b_Exit_MouseDown (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Exit.BackColor = mc0050
End Sub

Sub b_Exit_MouseUp (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Exit.BackColor = m0062
End Sub

Sub b_Game1_Click ()
    MousePointer = mc0032
    frm_SaveGame.Tag = Str$(gv11CE.M5334)
    gv11CE.M5334 = 1
    frm_SaveBox.Show
    Call sub277B
    MousePointer = mc006E
End Sub

