Sub b_Help_Click ()
    MousePointer = mc0032
    If  gv0060.M4C47 = True Then
        b_Sound.Command = "Close"
        b_Sound.FileName = Trim$(gv09F0.M4C15) + "help.wav"
        b_Sound.Command = "Open"
        b_Sound.Command = "Play"
    End If
    frm_Box1.FillElastic = "Help (Save Game As)"
    frm_Box1.b_Message = "You can save up to five different games. Just click on the position where you would like to save your game, and your game will be automatically saved on the hard drive under the SAVEGAME directory." + Chr$(10) + Chr$(10) + "At a later time you can load the saved game by clicking on the same position under the LOAD GAME menu."
    frm_Box1.Show 1
End Sub

Sub b_Help_MouseDown (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Help.BackColor = mc0050
End Sub

Sub b_Help_MouseUp (Button As Integer, Shift As Integer, X As Single, Y As Single)
    b_Help.BackColor = m0062
End Sub

Sub sub277B ()
    b_Exit = "Exit Without Saving"
    b_Game1 = Trim$(m001C(1))
    b_Game2 = Trim$(m001C(2))
    b_Game3 = Trim$(m001C(3))
    b_Game4 = Trim$(m001C(4))
    b_Game5 = Trim$(m001C(5))
End Sub

Sub sub2792 ()
Dim l0116
For l0116 = 1 To 5
    Open Trim$(gv09F0.M4C05) + "GAME" + Trim$(Format$(l0116, "#,#0")) For Binary As 6
        Get #6, 1, m001C(l0116)
    Close 6
Next
End Sub

Sub sub27C6 ()
Dim l0118
For l0118 = 1 To 5
    Open Trim$(gv09F0.M4C05) + "GAME" + Trim$(Format$(l0118, "#,#0")) For Binary As 5
        Put #5, 1, m001C(l0118)
    Close 5
Next
End Sub

Sub Form_Activate ()
    MousePointer = mc006E
End Sub

Sub Form_Load ()
    MousePointer = mc0032
    FillElastic.Picture = LoadPicture(Trim$(gv09F0.M4BF5) + "STARS4.BMP")
    Call sub2792
    Call sub277B
End Sub

Sub Label2_Click ()
    Label2 = "Mr. Zinn wants to build an orbiting truck stop here, but locals feel it would destroy the natural beauty of this space."
