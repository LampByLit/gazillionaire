Sub b_Planet_Click (Index%)
    MousePointer = mc001A
    If  gv11CE.M53A9(gv11CE.M53E5) = Index Then
        If  gv0060.M4C47 = True Then Beep
        frm_Box0.FillElastic = "Travel"
        frm_Box0.b_Message = Chr$(10) + "You are already on " + gv11CE.M53C1(Index) + ". Try another planet."
        frm_Box0.Show 1
    Else
        sub3B58 (Index)
    End If
End Sub

Sub sub3B58 (ByVal pv00AC As Integer)
Dim l00AE As Long
Dim l00B0
Dim l00B6 As Integer
Dim l00B8 As String
' Const mc00C2 = 65535& ' &HFFFF&
Static m00C6 As Long
' Const mc00DA = 1 ' &H1%
On Error GoTo LBB95A
    MousePointer = mc001A
    l00B6 = False
    l00B8 = ""
    FillElastic.Visible = False
    l00AE = 0
    For l00B0 = 0 To 6
        If  gv11CE.M5522 <= 15 Then
            l00AE = l00AE + gv0BF2.M4ED9(l00B0) * gv11CE.M54DA(l00B0, gv11CE.M5522)
        Else
            l00AE = l00AE + gv0BF2.M4ED9(l00B0) * gv11CE.M54DA(l00B0, 15)
        End If
    Next
    If  gv11CE.M5299(gv11CE.M53E5) = False Then
        gv11CE.M5384(gv11CE.M53E5) = l00AE + gv0BF2.M4CF9 + gv0BF2.M4E9E - gv0BF2.M4DA3 - gv0BF2.M4FBD
    Else
        gv11CE.M5384(gv11CE.M53E5) = 0
    End If
    Call sub00A2
    If  (gv0BF2.M4FBD > gv0BF2.M4FC9) Or (gv0BF2.M4DA3 > gv0BF2.M4DC7) Then
        frm_Box1Port.b_Yes = "Go To Main Menu"
        frm_Box1Port.b_No = "Bankrupt Me!"
        frm_Box1Port.b_Yes.Visible = True
        frm_Box1Port.b_No.Visible = True
        frm_Box1Port.b_OK.Visible = False
        frm_Box1Port.b_Container.BackColor = mc00C2
        frm_Box1Port.b_Message.ForeColor = m00C6
        If  gv0BF2.M4FBD > gv0BF2.M4FC9 Then
            frm_Box1Port.b_Message.Caption = "If you leave the planet now you will go bankrupt and lose the game! You cannot owe more than " + Format$(gv0BF2.M4FC9, "#,#0") + " kubars to Mr. Zinn." + Chr$(10) + Chr$(10) + "Do you want to return to the Main Menu and try to straighten out your finances?" + Chr$(10) + Chr$(10) + "If you click on BANKRUPT ME, you will leave the planet and lose the game. If you click on GO TO MAIN MENU, you will return to the Main Menu."
            frm_Box1Port.Image1.Picture = LoadPicture(Trim$(gv09F0.M4BF5) + "ZINN.BMP")
            frm_Box1Port.b_ImageLable = "Mr. Zinn"
            If  gv0060.M4C47 = True Then
                b_Sound.Command = "Close"
                b_Sound.FileName = Trim$(gv09F0.M4C15) + "zinn.wav"
                b_Sound.Command = "Open"
                b_Sound.Command = "Play"
            End If
        Else
            frm_Box1Port.b_Message.Caption = "If you leave the planet now you will go bankrupt and lose the game! You cannot owe more than " + Format$(gv0BF2.M4DC7, "#,#0") + " kubars to the Trader's Union." + Chr$(10) + Chr$(10) + "Do you want to return to the Main Menu and try to straighten out your finances?" + Chr$(10) + Chr$(10) + "If you click on BANKRUPT ME, you will leave the planet and lose the game. If you click on GO TO MAIN MENU, you will return to the Main Menu."
            frm_Box1Port.Image1.Picture = LoadPicture(Trim$(gv09F0.M4BF5) + "loan1.bmp")
            frm_Box1Port.b_ImageLable = "Trader's Union Official"
            If  gv0060.M4C47 = True Then
                frm_Box1Port.b_Sound.Command = "Close"
                frm_Box1Port.b_Sound.FileName = Trim$(gv09F0.M4C15) + "loan.wav"
                frm_Box1Port.b_Sound.Command = "Open"
                frm_Box1Port.b_Sound.Command = "Play"
            End If
        End If
        frm_Box1Port.Show 1
        MousePointer = mc001A
        If  frm_Box1Port.Tag = "YES" Then
            Unload frm_Box1Port
            l00B6 = True
        Else
            Unload frm_Box1Port
            For l00B0 = 0 To 6
                gv11CE.M5452(gv11CE.M53E5, l00B0) = 0
                gv11CE.M5464(gv11CE.M53E5, l00B0) = 0
                gv11CE.M5479(gv11CE.M53E5, l00B0) = 0
            Next
            If  gv0060.M4C47 = True Then b_Sound.Command = "Close"
            frm_Bankrupt1.Show
            Unload frm_LeavePlanet
            Exit Sub
        End If
    End If
    If  l00B6 = True Then
        frm_MainMenu.Show
        Unload frm_LeavePlanet
    Else
        If  gv0BF2.M4DF0 = True Then
            gv0BF2.M4E9E = gv0BF2.M4E9E + gv0BF2.M4CF9
            gv0BF2.M4CF9 = 0
        End If
        If  gv0BF2.M4E48 = False Then
            MousePointer = mc001A
            gv11CE.M53B3(gv11CE.M53E5) = gv11CE.M53A9(gv11CE.M53E5)
            gv11CE.M53A9(gv11CE.M53E5) = pv00AC
            If  gv11CE.M513F = 1 Or gv11CE.M513F = 2 Then
                frm_Auction.Tag = "TRAVEL0"
                frm_Auction.Show
            Else
                frm_Travel0.Show
            End If
            Unload frm_LeavePlanet
        Else
            MousePointer = mc001A
            gv11CE.M53B3(gv11CE.M53E5) = gv11CE.M53A9(gv11CE.M53E5)
            gv11CE.M53A9(gv11CE.M53E5) = pv00AC
            If  gv11CE.M513F = 1 Or gv11CE.M513F = 2 Then
                frm_Auction.Tag = "TRAVEL1"
                frm_Auction.Show
            Else
                frm_Travel1.Show
            End If
            Unload frm_LeavePlanet
        End If
    End If
    Exit Sub

LBB95A:
    Call sub012D(Err)
    Resume
End Sub

