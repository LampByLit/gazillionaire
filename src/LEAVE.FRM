Sub Form_Load ()
Dim l00DE
' Const mc00E6 = 255& ' &HFF&
    MousePointer = mc001A
    FillElastic.Picture = LoadPicture(Trim$(gv09F0.M4BF5) + "STARS2.BMP")
    For l00DE = 0 To 6
        b_Planet(l00DE).Picture = LoadPicture(Trim$(gv09F0.M4BF5) + gv11CE.M53C1(l00DE) + "1.bmp")
        b_Planet(l00DE) = gv11CE.M53C1(l00DE)
    Next
    If  gv11CE.M552A = True And gv11CE.M4FFC < gv11CE.M510F Then
       b_Facility.Visible = False
    End If
    If  gv11CE.M552A = True And gv11CE.M4FFC < gv11CE.M50FB Then
        b_DistanceChart.Visible = False
    End If
    If  gv0BF2.M4EE2 >= 0 And gv0BF2.M4EE2 <= 6 Then
        b_Planet(gv0BF2.M4EE2).ForeColor = mc00C2
    End If
    b_Planet(gv11CE.M53A9(gv11CE.M53E5)).ForeColor = mc00E6
End Sub

