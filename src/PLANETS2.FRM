Sub b_Planet_Click (Index%)
    gv11CE.M53C1(m0036) = b_Planet(Index)
    Call sub1F87
End Sub

Sub b_Text_Click (Index%)
' Const mc0046 = 11 ' &HB%
    gv11CE.M53C1(m0036) = b_Planet(Index)
    Call sub1F87
End Sub

Sub sub1F87 ()
    MousePointer = mc0046
    Unload frm_Planets2
End Sub

Function fn1FA1 (ByVal pv0054 As Integer) As String
    Select Case pv0054
        Case 0
            fn1FA1 = "Vexx"
        Case 1
            fn1FA1 = "Pyke"
        Case 2
            fn1FA1 = "Mira"
        Case 3
            fn1FA1 = "Stye"
        Case 4
            fn1FA1 = "Loro"
        Case 5
            fn1FA1 = "Zile"
        Case 6
            fn1FA1 = "Frac"
        Case 7
            fn1FA1 = "Tilo"
        Case 8
            fn1FA1 = "Queg"
        Case 9
            fn1FA1 = "Xeen"
        Case 10
            fn1FA1 = "Ooom"
        Case 11
            fn1FA1 = "Hork"
        Case 12
            fn1FA1 = "Bass"
        Case 13
            fn1FA1 = "Nosh"
    End Select
End Function

Function fn1FAD (ByVal p0058) As Integer
    Select Case p0058
        Case "Vexx"
            fn1FAD = 0
        Case "Pyke"
            fn1FAD = 1
        Case "Mira"
            fn1FAD = 2
        Case "Stye"
            fn1FAD = 3
        Case "Loro"
            fn1FAD = 4
        Case "Zile"
            fn1FAD = 5
        Case "Frac"
            fn1FAD = 6
        Case "Tilo"
            fn1FAD = 7
        Case "Queg"
            fn1FAD = 8
        Case "Xeen"
            fn1FAD = 9
        Case "Ooom"
            fn1FAD = 10
        Case "Hork"
            fn1FAD = 11
        Case "Bass"
            fn1FAD = 12
        Case "Nosh"
            fn1FAD = 13
    End Select
End Function

Function fn1FBE (ByVal pv005C As Integer) As String
' Const mc005E = 1 ' &H1%
Select Case pv005C
    Case 0
        fn1FBE = "Vexx is the capital of Kukubia and the seat of the Imperial Magistrate."
    Case 1
        fn1FBE = "Pyke is a major industrial center and the only place to purchase new L-Tech engines."
    Case 2
        fn1FBE = "Mira is the heart of Kukubia's religion and sacred resting spot of the Quaso Mutta."
    Case 3
        fn1FBE = "Stye is the financial hub of the system and home of the Trader's Union."
    Case 4
        fn1FBE = "Loro is renowned throughout Kukubia as a great vacation spot."
    Case 5
        fn1FBE = "Zile is a wealthy merchant's planet and home to Mr. Zinn."
    Case 6
        fn1FBE = "Frac is the headquarters of the Voyager's Insurance Company."
    Case 7
        fn1FBE = "Tilo is the gambler's planet packed with wall to wall casinos."
    Case 8
        fn1FBE = "Queg is the infamous smuggler's haven."
    Case 9
        fn1FBE = "Xeen is one giant junkyard filled with spare ship parts and brilliant mechanics."
    Case 10
        fn1FBE = "Ooom is the mystical fortune teller's planet."
    Case 11
        fn1FBE = "Hork is the media capital of Kukubia."
    Case 12
        fn1FBE = "Bass is a playground for stock market analysts."
    Case 13
        fn1FBE = "Nosh is known as the fuel depot for the entire system."
End Select
End Function

Sub Form_Activate ()
    MousePointer = mc005E
End Sub

Sub Form_KeyPress (KeyAscii As Integer)
    Select Case KeyAscii
        Case 13, 27, 32
            Call sub1F87
    End Select
End Sub

Sub Form_Load ()
Dim l0062
Dim l0064
    MousePointer = mc0046
    If  frm_Planets2.WindowState = 0 Then
        frm_Planets2.Move (Screen.Width - frm_Planets2.Width) / 2, ((Screen.Height - frm_Planets2.Height) / 2)
    End If
    m0036 = Val(frm_Planets.Tag)
    For l0062 = 0 To 13
        m0020(l0062) = -1
        For l0064 = 0 To 6
            If  fn1FA1(l0062) = gv11CE.M53C1(l0064) Then
               m0020(l0062) = l0064
            End If
        Next
    Next
    b_Planet(7) = gv11CE.M53C1(m0036)
    b_Planet(7).Picture = LoadPicture(Trim$(gv09F0.M4BF5) + gv11CE.M53C1(m0036) + "1.bmp")
    b_Text(7) = fn1FBE(fn1FAD(gv11CE.M53C1(m0036)))
    For l0062 = 0 To 6
        For l0064 = 0 To 13
            If  m0020(l0064) = -1 Then
                m0020(l0064) = -2
                b_Planet(l0062).Picture = LoadPicture(Trim$(gv09F0.M4BF5) + fn1FA1(l0064) + "1.bmp")
                b_Planet(l0062) = fn1FA1(l0064)
                b_Text(l0062) = fn1FBE(l0064)
                l0064 = 13
            End If
        Next
    Next
End Sub
